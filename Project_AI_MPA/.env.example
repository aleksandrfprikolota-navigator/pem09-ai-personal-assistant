# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ официального OpenAI API: https://platform.openai.com/api-keys
# ProxyAPI не используется
OPENAI_API_KEY=

# Режим по умолчанию: text, voice, vision, rag
BOT_MODE=text

# Голос TTS: alloy, echo, nova, fable, onyx, shimmer
DEFAULT_VOICE=alloy

LOG_LEVEL=INFO
